{
  "name": "pixel-pet-affection",
  "productName": "Pixel Pet Affection",
  "version": "0.21.0",
  "description": "Adult (18+) affection edition of a pixel-art desktop pet powered by a LobeHub agent",
  "main": "src/main/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js",
    "prestart": "npm run build:admin",
    "start": "electron .",
    "prestart:no-sandbox": "npm run build:admin",
    "start:no-sandbox": "electron . --no-sandbox",
    "predemo": "npm run build:admin",
    "demo": "node scripts/demo.js",
    "test": "node --test \"test/*.test.js\"",
    "e2e": "node e2e/run.js",
    "build:admin": "vite build --config admin/vite.config.mjs",
    "dev:admin": "vite --config admin/vite.config.mjs",
    "typecheck:admin": "tsc -p admin",
    "design:tokens": "node scripts/build-design-tokens.mjs",
    "design:preview": "npm run build:admin && electron scripts/design-preview.js --no-sandbox",
    "lint:design": "node .agents/skills/lobe-design/scripts/lint-lobe.mjs admin/src",
    "predist:mac": "npm run build:admin",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "predist:win": "npm run build:admin",
    "dist:win": "electron-builder --win --x64 --publish never",
    "predist:linux": "npm run build:admin",
    "dist:linux": "electron-builder --linux tar.gz --x64 --publish never"
  },
  "devDependencies": {
    "@lobehub/fluent-emoji": "^5.0.1",
    "@lobehub/icons": "^6.14.0",
    "@lobehub/ui": "^6.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "playwright": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "author": {
    "name": "LiJian",
    "email": "onlyyoulove3@gmail.com"
  },
  "homepage": "https://github.com/rdmclin2/lobehub-pixel-pet-affection",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdmclin2/lobehub-pixel-pet-affection.git"
  },
  "build": {
    "appId": "com.rdmclin2.pixelpet.affection",
    "productName": "Pixel Pet Affection",
    "copyright": "Copyright © LiJian, rdmclin2",
    "files": [
      "src/**/*",
      "!**/*.vrm",
      "!**/*.VRM",
      "!**/*.vrma",
      "!**/*.VRMA",
      "!**/*.fbx",
      "!**/*.FBX",
      "!**/*.vmd",
      "!**/*.bvh",
      "!**/*.pmx",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "PixelPetAffection-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "语音输入：点一下或按住聊天框旁的 🎤 时，桌宠用麦克风录下你的话并转成文字。不点按钮时不会录音。"
      }
    },
    "dmg": {
      "title": "Pixel Pet Affection ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "PixelPetAffection-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "PixelPetAffection-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "executableName": "pixel-pet-affection",
      "artifactName": "PixelPetAffection-${version}-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rdmclin2",
        "repo": "lobehub-pixel-pet-affection",
        "releaseType": "release"
      }
    ]
  },
  "bugs": {
    "url": "https://github.com/rdmclin2/lobehub-pixel-pet-affection/issues"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
