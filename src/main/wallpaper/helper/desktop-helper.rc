// Version resource and manifest of pixelpet-desktop-helper.exe (docs/wallpaper-mode.md §1.1.3): the file says what it
// is (product name and purpose), runs asInvoker, Per-Monitor-V2. Compiled by scripts/build-win-helper.js (windres).
#include <winver.h>
#include <winuser.h>

1 RT_MANIFEST "desktop-helper.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404B0"
    BEGIN
      VALUE "CompanyName", "rdmclin2"
      VALUE "FileDescription", "Pixel Pet 桌面壁纸助手 (desktop wallpaper helper)"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "pixelpet-desktop-helper"
      VALUE "LegalCopyright", "Copyright (C) LiJian, rdmclin2. MIT License."
      VALUE "OriginalFilename", "pixelpet-desktop-helper.exe"
      VALUE "ProductName", "Pixel Pet Affection"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
